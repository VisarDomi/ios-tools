#!/usr/bin/env python3
"""PC client for an already running mac-workload simulator session.

Set SIM or --device explicitly. This tool never boots a guest. Commands: shot,
hook, install, launch, terminate, container. See native/MAC-WORKLOADS.md.
"""
import argparse
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--device', default=os.environ.get('SIM'))
parser.add_argument('action', choices=['shot','hook','install','launch','terminate','container'])
parser.add_argument('args', nargs='*')
a = parser.parse_args()
if not a.device or not re.fullmatch(r'[A-Fa-f0-9-]{36}', a.device):
    parser.error('Select the exact simulator UUID with SIM or --device')
if not a.args:
    parser.error('This action requires an argument')

guard = '~/Developer/ios-tools/native/scripts/mac-workload assert-simulator --device ' + shlex.quote(a.device)
def remote(command, cleanup=False):
    program = command if cleanup else guard + ' && ' + command
    return subprocess.run(['ssh','-o','BatchMode=yes','mac',program],capture_output=True,check=True,timeout=55).stdout

cmd = ['simctl']
if a.action == 'hook':
    if not a.args[0].startswith('/'):
        parser.error('Hook path must start with /')
    sys.stdout.buffer.write(remote(shlex.join(['curl','--fail','--silent','--show-error','--max-time','10','http://127.0.0.1:8765'+a.args[0]])))
elif a.action == 'shot':
    data = remote('~/Developer/ios-tools/native/scripts/apple-tool '+shlex.join(cmd+['io',a.device,'screenshot','-']))
    scale = int(a.args[1]) if len(a.args)>1 else 3
    if scale < 1:
        parser.error('Scale must be positive')
    from PIL import Image
    from io import BytesIO
    im=Image.open(BytesIO(data))
    im.resize((max(1,im.width//scale),max(1,im.height//scale))).save(Path(a.args[0]))
else:
    operation = {'install':['install',a.device,*a.args],
                 'launch':['launch',a.device,*a.args],
                 'terminate':['terminate',a.device,*a.args],
                 'container':['get_app_container',a.device,a.args[0],'data']}[a.action]
    sys.stdout.buffer.write(remote('~/Developer/ios-tools/native/scripts/apple-tool '+shlex.join(cmd+operation),cleanup=a.action=='terminate'))
