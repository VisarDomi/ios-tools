#!/usr/bin/env python3
"""Run one bounded Mac build or owned simulator session under the shared signing lock.

Run inside the logged-in Mac GUI bootstrap (see native/MAC-WORKLOADS.md).
This is an attached command, not a LaunchAgent. It never controls a physical phone.
"""
import argparse
import contextlib
import ctypes
import datetime
import fcntl
import json
import os
from pathlib import Path
import platform
import plistlib
import re
import shutil
import signal
import subprocess
import sys
import time
sys.path.insert(0,str(Path(__file__).resolve().parent))
from build_queue_priority import queued_delivery
from apple_tools import tool_path
from simulator_environment import checked_wasm_overrides,intel_wasm_overrides

ROOT = Path.home() / 'Library/Caches/ios-app-refresh'
POLICY = Path.home() / 'Library/Application Support/ios-tools/mac-workload.json'
PROFILES = Path(__file__).resolve().parents[1] / 'simulator-profiles.json'
PROFILE_STATE = POLICY.parent / 'simulator-profile'
SIM_LAUNCHD_STATE = Path('/private/var/tmp')
LOCK = ROOT / 'signing.lock'
WARM = ROOT / 'simulator-warm.json'
WARM_SECONDS = 3600
PANIC_REPORTS = Path('/Library/Logs/DiagnosticReports')
_CPU_PORT = None
_CPU_TICKS = None
_MACH = None


class UnsafeWorkload(RuntimeError):
    pass


def capture(argv, timeout=10):
    return subprocess.check_output(argv, timeout=timeout, stderr=subprocess.PIPE)


def policy():
    return json.loads(POLICY.read_text()) if POLICY.exists() else {}


def check_panic_reports(settings):
    known=settings.get('acknowledgedPanicReports')
    for suffix, acknowledged, label in (
            ('panic', known, 'kernel panic'),
            ('gpuRestart', settings.get('acknowledgedGpuResetReports'), 'GPU reset')):
        if acknowledged is None:
            continue
        current={p.name for p in PANIC_REPORTS.glob('*.'+suffix) if not p.name.startswith('.')}
        new=current-set(acknowledged)
        if new:
            raise UnsafeWorkload('New Mac '+label+' report: '+', '.join(sorted(new))+
                                 '; review it and revalidate the graphics policy before simulator work')


class SimulatorFailureWatch:
    """GPU resets are host-wide; only WebContent crashes can be guest-scoped."""
    def __init__(self, device, allow_webcontent_crash=False):
        self.graphics={p.name for suffix in ('panic','gpuRestart')
                       for p in PANIC_REPORTS.glob('*.'+suffix) if not p.name.startswith('.')}
        self.web=None if allow_webcontent_crash else WebContentCrashWatch(device)

    def failure(self):
        current={p.name for suffix in ('panic','gpuRestart')
                 for p in PANIC_REPORTS.glob('*.'+suffix) if not p.name.startswith('.')}
        new=current-self.graphics
        if new:
            return 'New Mac graphics failure report: '+', '.join(sorted(new))+'; inspect before another simulator launch'
        return self.web.failure() if self.web else None


class WebContentCrashWatch:
    """Stop a failed owned guest once, rather than letting an app crash-loop."""
    def __init__(self, device, root=None, started=None):
        self.device=device
        self.root=root or Path.home()/'Library/Logs/DiagnosticReports'
        self.started=time.time() if started is None else started
        self.seen={p.name for p in self.root.glob('com.apple.WebKit.WebContent*.ips')}

    def failure(self):
        for path in self.root.glob('com.apple.WebKit.WebContent*.ips'):
            if path.name in self.seen:continue
            try:
                text=path.read_text()
                try:report=json.loads(text)
                except json.JSONDecodeError:report=json.loads(text.split('\n',1)[1])
                launch=datetime.datetime.strptime(report['procLaunch'],'%Y-%m-%d %H:%M:%S.%f %z').timestamp()
            except (OSError,ValueError,KeyError,IndexError):
                continue # Reports can still be materializing; retry next sample.
            self.seen.add(path.name)
            if (report.get('coalitionName')=='com.apple.CoreSimulator.SimDevice.'+self.device
                    and launch>=self.started-1):
                return 'Owned simulator WebContent crashed: '+path.name+'; inspect the report before another launch'
        return None


def idle_delta(before,after):
    delta=[(new-old)&0xffffffff for old,new in zip(before,after)]
    return 100*delta[2]/sum(delta) if sum(delta) else None


def cpu_idle():
    # Public Mach HOST_CPU_LOAD_INFO: four natural_t counters, idle at index2.
    # Cache one host send right for this short-lived guard process.
    global _CPU_PORT,_CPU_TICKS,_MACH
    if _MACH is None:
        _MACH=ctypes.CDLL('/usr/lib/libSystem.B.dylib',use_errno=True)
    if _CPU_PORT is None:
        _MACH.mach_host_self.restype=ctypes.c_uint32
        _MACH.host_statistics.argtypes=[ctypes.c_uint32,ctypes.c_int,ctypes.c_void_p,ctypes.POINTER(ctypes.c_uint32)]
        _CPU_PORT=_MACH.mach_host_self()
    ticks=(ctypes.c_uint32*4)();count=ctypes.c_uint32(4)
    if _MACH.host_statistics(_CPU_PORT,3,ctypes.byref(ticks),ctypes.byref(count))!=0 or count.value!=4:
        return None
    current=list(ticks)
    result=idle_delta(_CPU_TICKS,current) if _CPU_TICKS is not None else None
    _CPU_TICKS=current
    return result


def memory_pressure():
    # Read the kernel value in-process. Spawning /usr/sbin/sysctl made the old
    # "health" probe measure scheduling/exec contention during simulator boot,
    # causing aborts even while the kernel reported normal memory pressure.
    global _MACH
    if _MACH is None:
        _MACH=ctypes.CDLL('/usr/lib/libSystem.B.dylib',use_errno=True)
    function=_MACH.sysctlbyname
    function.argtypes=[ctypes.c_char_p,ctypes.c_void_p,ctypes.POINTER(ctypes.c_size_t),ctypes.c_void_p,ctypes.c_size_t]
    function.restype=ctypes.c_int
    value=ctypes.c_uint32();size=ctypes.c_size_t(ctypes.sizeof(value))
    if function(b'kern.memorystatus_vm_pressure_level',ctypes.byref(value),ctypes.byref(size),None,0)!=0:
        number=ctypes.get_errno()
        raise OSError(number,'Unable to read kernel memory pressure')
    if size.value!=ctypes.sizeof(value) or value.value not in (1,2,4):
        raise UnsafeWorkload('Unexpected kernel memory pressure response')
    return value.value


def metrics():
    started=time.monotonic()
    sample=dict(load=os.getloadavg()[0],cpuIdle=cpu_idle(),
                pressure=memory_pressure(),
                diskGiB=shutil.disk_usage(Path.home()).free / 2**30)
    sample['probeSeconds']=time.monotonic()-started
    return sample


def command_app(command):
    """The ios-push project a check belongs to, from a path in its command (e.g. ~/Developer/video-platform/apps/ios/...)."""
    apps = json.loads(PROFILES.read_text())['apps']
    for argument in command:
        for part in Path(argument).parts:
            for app in apps:
                if part == app or part.startswith(app + '-'):
                    return app
    return None


def simulator_profile(runtime, needs=(), app=None, full=False):
    """The launchd jobs to disable for this boot and a description of the profile.
    Lean by default: an iOS guest starts ~180 jobs, most of them (Siri, Health, Home, Mail, App
    Store, iCloud sync, widgets, ...) irrelevant to an app check; --needs/--app keep groups."""
    profiles = json.loads(PROFILES.read_text())
    platform_name = next((name for name in profiles['platforms'] if '.SimRuntime.' + name + '-' in runtime), None)
    wanted = list(needs)
    if app:
        if app not in profiles['apps']:
            raise UnsafeWorkload('Unknown app for simulator needs: ' + app + ' (see simulator-profiles.json)')
        wanted += profiles['apps'][app]
    if full or platform_name is None:
        return [], 'full' + ('' if full else ' (no profile for this runtime)')
    profile = profiles['platforms'][platform_name]
    unknown = [need for need in wanted if need not in profile['needs']]
    if unknown:
        raise UnsafeWorkload('Unknown simulator needs: ' + ', '.join(unknown) + '; known: ' + ', '.join(sorted(profile['needs'])))
    kept = {job for need in wanted for job in profile['needs'][need]}
    disabled = [job for job in profile['lean'] if job not in kept]
    return disabled, 'lean' + ''.join(' +' + need for need in sorted(set(wanted)))


def atomic_write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name('.' + path.name + '.tmp')
    with open(temporary, 'wb') as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)


def apply_simulator_profile(device, disabled_jobs):
    """Set the launchd overrides the next boot of this shut-down guest reads.
    simctl boot --disabledJob only writes /private/tmp/<guest>/disabled.plist, which launchd_sim
    ignores for user-domain jobs (nearly all of iOS), so this edits launchd_sim's persisted
    overrides instead. The value each label had before it was first touched is kept in a sidecar,
    so --full or a smaller profile restores it exactly (e.g. the companion jobs CoreSimulator
    enables for a paired watch). Written sidecar first, so an interruption at any point leaves
    the next session able to restore."""
    overrides = SIM_LAUNCHD_STATE / ('com.apple.CoreSimulator.SimDevice.' + device) / 'disabled.plist'
    sidecar = PROFILE_STATE / (device + '.json')
    current = plistlib.loads(overrides.read_bytes()) if overrides.exists() else {}
    originals = json.loads(sidecar.read_text()) if sidecar.exists() else {}
    if not originals and not disabled_jobs:
        return
    for label in list(originals):
        # Still disabled (ours): put the original back. Changed by someone else since: adopt that.
        value = originals[label] if current.get(label) is True else current.get(label)
        originals[label] = value
        if value is None:
            current.pop(label, None)
        else:
            current[label] = value
    for label in disabled_jobs:
        originals.setdefault(label, current.get(label))
        current[label] = True
    atomic_write(sidecar, json.dumps(originals, sort_keys=True).encode())
    if overrides.parent.exists() or disabled_jobs:
        overrides.parent.mkdir(mode=0o700, exist_ok=True)
        atomic_write(overrides, plistlib.dumps(current))


def devices():
    result = json.loads(capture([tool_path('simctl'), 'list', 'devices', '--json'], 15))
    return [dict(item, runtime=runtime) for runtime, group in result['devices'].items() for item in group]


def process_identity(pid):
    result=subprocess.run(['/bin/ps','-ww','-p',str(pid),'-o','lstart=','-o','command='],capture_output=True,text=True,timeout=3)
    return result.stdout.strip() if result.returncode==0 else None


def guest_boot_identity(device):
    """The launchd_sim process of this boot: a later boot of the same guest has another PID/start."""
    result=subprocess.run(['/usr/bin/pgrep','-f','launchd_sim .*/Devices/%s/'%device],capture_output=True,text=True,timeout=5)
    pids=[int(x) for x in result.stdout.split()]
    identity=process_identity(pids[0]) if len(pids)==1 else None
    return dict(pid=pids[0],identity=identity) if identity else None


def simulator_gui_owner():
    pids=[]
    for _ in range(25):
        result=subprocess.run(['/usr/bin/pgrep','-x','Simulator'],capture_output=True,text=True,timeout=3)
        pids=[int(x) for x in result.stdout.split()]
        if pids:break
        time.sleep(.2)
    if len(pids)!=1:raise UnsafeWorkload('Cannot establish ownership of one Simulator GUI process')
    identity=process_identity(pids[0])
    if not identity or '/Simulator.app/Contents/MacOS/Simulator' not in identity:
        raise UnsafeWorkload('Unexpected Simulator GUI process identity')
    return dict(pid=pids[0],identity=identity)


def close_owned_simulator_gui(owner):
    if not owner:raise UnsafeWorkload('Simulator GUI ownership was not established; inspect before cleanup')
    def present():
        identity=process_identity(owner['pid'])
        if identity is not None and identity!=owner['identity']:
            # While it exits, ps shows the same process (same start time) as "(Simulator)".
            if identity.split()[:5]==owner['identity'].split()[:5] and identity.split()[5:] in (['(Simulator)'],['<defunct>']):
                return False
            raise UnsafeWorkload('Simulator GUI PID identity changed (now %r); refusing to signal it'%identity)
        return identity is not None
    if not present():return
    # A successful AppleScript return is only a quit request, not proof of exit.
    try:subprocess.run(['/usr/bin/osascript','-e','tell application id "com.apple.iphonesimulator" to quit'],check=True,timeout=5,capture_output=True)
    except subprocess.SubprocessError:pass
    for _ in range(10):
        if not present():return
        time.sleep(.2)
    if present():os.kill(owner['pid'],signal.SIGTERM)
    for _ in range(20):
        if not present():return
        time.sleep(.2)
    raise UnsafeWorkload('Owned Simulator GUI did not exit; retained recovery lease')


def preflight(sample, booted, xcode_busy=False, allow_stale_load=False):
    reasons = []
    if sample['load'] > 6 and not allow_stale_load:
        reasons.append('load %.2f > 6; let the Mac settle' % sample['load'])
    if sample['pressure'] != 1:
        reasons.append('memory pressure is not normal')
    if sample['diskGiB'] < 12:
        reasons.append('less than 12 GiB free')
    if booted:
        reasons.append('a simulator is already booted: ' + ', '.join(booted))
    if xcode_busy:
        reasons.append('an Xcode build is already running')
    if reasons:
        raise UnsafeWorkload('; '.join(reasons))


def wait_for_idle(wait=0, kind='simulator', warm=None):
    """Builds can prove CPU headroom instead of waiting for a lagging load average.
    `warm` is the idle guest this guard holds after a session; it is not someone else's workload."""
    end=time.monotonic()+max(8 if kind=='build' else 0,min(wait,300))
    announced=False
    quiet_samples=0
    while True:
        known=devices()
        sample=metrics()
        if warm and sample['pressure']!=1:
            release_warm(warm,'memory pressure before a %s'%kind)
            warm=None
            known=devices()
        if warm:
            known=[x for x in known if x['udid']!=warm['device']]
        if kind=='simulator' and queued_delivery():
            raise UnsafeWorkload('Simulator deferred to queued app delivery')
        busy=subprocess.run(['/usr/bin/pgrep','-x','xcodebuild'],stdout=subprocess.DEVNULL).returncode==0
        # Do not wait for/take over another person's workload or GUI.
        if any(x['state']!='Shutdown' for x in known) or busy or sample['diskGiB']<12 or sample['pressure']>=4:
            preflight(sample,[x['udid'] for x in known if x['state']!='Shutdown'],busy)
        try:
            idle=sample.get('cpuIdle')
            quiet=(kind=='build' and idle is not None and idle>=50 and sample.get('probeSeconds',float('inf'))<.5
                   and sample['pressure']==1 and sample['diskGiB']>=12)
            quiet_samples=quiet_samples+1 if quiet else 0
            preflight(sample,[],busy,allow_stale_load=quiet_samples>=3)
            if sample['load']>6:
                print('Admitting build after three idle CPU samples; residual load %.2f, CPU idle %.1f%%'%(sample['load'],idle),flush=True)
            return devices() if warm else known
        except UnsafeWorkload:
            if time.monotonic()>=end:raise
            if not announced:
                print('Waiting up to %ss for a quiet Mac; no guest or compiler has started'%wait,flush=True)
                announced=True
            time.sleep(min(2 if kind=='build' else 5,max(0,end-time.monotonic())))


def simulator_policy(settings, trial, current_coalescing=None, now=None, current_renderstandby=None):
    required = settings.get('requiredMetalCoalesce')
    if required is not None and current_coalescing != required:
        raise UnsafeWorkload('The recorded graphics patch is not active: MetalCoalesce does not match.')
    required=settings.get('requiredRenderStandby')
    if required is not None and current_renderstandby!=required:
        raise UnsafeWorkload('The recorded Render Standby workaround is not active.')
    reason = settings.get('simulatorBlockedReason')
    if not reason:
        return
    now = time.time() if now is None else now
    if not trial or settings.get('trialUntil', 0) <= now or not settings.get('trialChange'):
        raise UnsafeWorkload('Simulator quarantined: ' + reason + '. A recorded, time-limited driver trial is required.')


def metal_coalescing():
    entries = plistlib.loads(capture(['/usr/sbin/ioreg', '-a', '-r', '-c', 'IntelAccelerator']))
    return entries[0].get('Development', {}).get('MetalCoalesce') if entries else None


def render_standby(settings):
    if 'requiredRenderStandby' not in settings:
        return None
    entries=plistlib.loads(capture(['/usr/sbin/ioreg','-a','-r','-c','AppleIntelFramebufferController']))
    return entries[0].get('FeatureControl',{}).get('RenderStandby') if entries else None


@contextlib.contextmanager
def signing_lock(wait=30):
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    inherited = os.environ.get('IOS_REFRESH_LOCK_FD')
    with LOCK.open('a') as lock:
        fd = lock.fileno()
        if inherited is not None:
            fd = int(inherited)
            actual, expected = os.fstat(fd), LOCK.stat()
            if (actual.st_dev, actual.st_ino) != (expected.st_dev, expected.st_ino):
                raise UnsafeWorkload('Inherited signing lock has the wrong identity')
        deadline=time.monotonic()+wait
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic()>=deadline:
                    raise UnsafeWorkload('Another build, renewal, simulator, or device-maintenance check owns the shared Mac lock')
                time.sleep(.5)
        yield fd


def bounded_jobs(command):
    command = list(command)
    index = 1 if Path(command[0]).name == 'xcrun' else 0
    tool = Path(command[index]).name
    if tool == 'xcodebuild':
        if '-jobs' in command:
            command[command.index('-jobs') + 1] = '2'
        else:
            command[index + 1:index + 1] = ['-jobs', '2']
    elif tool == 'swift' and len(command) > index + 1 and command[index + 1] in ('build', 'test'):
        for flag in ('--jobs', '-j'):
            if flag in command:
                command[command.index(flag) + 1] = '2'
                break
        else:
            command += ['--jobs', '2']
    return command


def stop_owned_process(process):
    # Only the process group this invocation created. Never kill by process name.
    # A wrapper can exit while a compiler grandchild remains in its group.
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    if process.poll() is None:
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
    end=time.monotonic()+2
    while time.monotonic()<end:
        try:
            os.killpg(process.pid,0)
        except ProcessLookupError:
            return
        time.sleep(.1)
    try:
        os.killpg(process.pid,signal.SIGKILL)
    except ProcessLookupError:
        pass
    if process.poll() is None:
        process.wait(timeout=5)


def trial_limits(settings, trial, kind='build'):
    # Only an explicit, expiring driver trial can calibrate startup load. The
    # absolute ceiling stays bounded; critical memory/disk checks never change.
    if trial:
        return dict(soft=min(40, settings.get('trialSoftLoad',16)),
                    hard=min(80, settings.get('trialHardLoad',40)))
    if kind=='simulator' and not settings.get('simulatorBlockedReason'):
        return dict(soft=min(40,settings.get('simulatorSoftLoad',16)),
                    hard=min(80,settings.get('simulatorHardLoad',40)))
    return dict(soft=16, hard=40)


def pressure_failure(sample, previous, now, limits=None):
    limits = limits or dict(soft=16, hard=40)
    latency=sample.get('probeSeconds')
    # Load includes queued startup work. With actual telemetry, require impaired
    # control responsiveness too; a high queue count alone is not a freeze.
    slow=latency is not None and latency>2
    queued=sample['load']>limits['soft'] and (latency is None or latency>1)
    bad = queued or slow or sample['pressure'] != 1
    since = previous if previous is not None and bad else (now if bad else None)
    if sample['load'] > limits['hard'] and (latency is None or latency>3):
        return 'high load with an unresponsive health probe', since
    if sample['pressure'] >= 4:
        return 'critical memory pressure', since
    if sample['diskGiB'] < 8:
        return 'free disk fell below 8 GiB', since
    if since is not None and now - since >= 12:
        return 'sustained loss of responsiveness or memory pressure', since
    return None, since


def monitor(command, deadline, log, fd, phase, limits=None, extra_env=None, crash_watch=None, yield_to_builds=False, warm=None):
    env = dict(os.environ, IOS_REFRESH_LOCK_FD=str(fd), IOS_WORKLOAD_ACTIVE=str(os.getpid()))
    env.update(extra_env or {})
    process = subprocess.Popen(command, env=env, pass_fds=(fd,), start_new_session=True)
    since = None
    try:
        while process.poll() is None:
            now = time.monotonic()
            sample = metrics()
            log.write(json.dumps(dict(phase=phase, at=time.time(), **sample)) + '\n')
            log.flush()
            reason, since = pressure_failure(sample, since, now, limits)
            if warm and since is not None:
                # The held idle guest goes first; the build continues if that was enough.
                release_warm(warm, 'the host is under pressure during a build')
                warm, since = None, None
                if reason != 'free disk fell below 8 GiB':
                    reason = None
            if yield_to_builds:
                pending=queued_delivery()
                if pending: reason='Simulator yielding to queued app delivery '+pending
            if crash_watch is not None:reason=crash_watch.failure() or reason
            if reason or now >= deadline:
                raise UnsafeWorkload(reason or 'workload deadline expired')
            time.sleep(min(2, max(0, deadline - now)))
        # A short child can finish between samples while a report is published.
        if crash_watch is not None:
            reason=crash_watch.failure()
            if reason:raise UnsafeWorkload(reason)
        if process.returncode:
            raise subprocess.CalledProcessError(process.returncode, command)
    finally:
        stop_owned_process(process)


def shutdown(device):
    # The exact guest was Shutdown before this invocation booted it.
    result = subprocess.run([tool_path('simctl'), 'shutdown', device],
                            capture_output=True, text=True, timeout=45)
    if result.returncode and any(x['udid'] == device and x['state'] != 'Shutdown' for x in devices()):
        raise UnsafeWorkload('Owned simulator did not shut down: ' + result.stderr.strip())


def warm_seconds(settings=None):
    settings = policy() if settings is None else settings
    return max(0, int(settings.get('simulatorWarmSeconds', WARM_SECONDS)))


def graphics_reports():
    return sorted(p.name for suffix in ('panic', 'gpuRestart') for p in PANIC_REPORTS.glob('*.' + suffix) if not p.name.startswith('.'))


def warm_state():
    try:
        return json.loads(WARM.read_text())
    except (OSError, ValueError):
        return None


def held_warm(known, drop=True):
    """The idle guest a previous session left booted, if it is still that same boot. A record whose guest
    is gone (shut down, a reboot) or was booted again by someone else is dropped, never acted on."""
    state = warm_state()
    if not state:
        return None
    known = devices() if known is None else known
    device = state.get('device')
    if any(x['udid'] == device and x['state'] == 'Booted' for x in known) and guest_boot_identity(device) == state.get('boot'):
        return state
    if drop:
        WARM.unlink(missing_ok=True)
    return None


def release_warm(state, reason):
    """Shut down the held guest. Callers hold the shared lock."""
    print('Simulator warm hold ended (%s): shutting down %s' % (reason, state['device']), flush=True)
    shutdown(state['device'])
    if (warm_state() or {}).get('token') == state.get('token'):
        WARM.unlink(missing_ok=True)


def user_apps_running(device):
    result = subprocess.run([tool_path('simctl'), 'spawn', device, 'launchctl', 'list'], capture_output=True, text=True, timeout=20)
    if result.returncode:
        raise UnsafeWorkload('Cannot list the apps running in the guest')
    return sorted({m.group(1) for m in re.finditer(r'UIKitApplication:([^\[\s]+)\[', result.stdout)
                   if not m.group(1).startswith('com.apple.')})


def hold_warm(device, gui_owner, profile, disabled_jobs, booted_at, seconds):
    """Leave the guest booted and idle for `seconds` after this session: next session skips the boot and
    installd's first-install scan. The test apps are stopped and the window closed, so nothing renders and
    a power loss or login cannot bring the guest back (Simulator.app reopens only if its window was open)."""
    for bundle in user_apps_running(device):
        subprocess.run([tool_path('simctl'), 'terminate', device, bundle], capture_output=True, timeout=20)
    left = user_apps_running(device)
    if left:
        raise UnsafeWorkload('Apps still running in the guest: ' + ', '.join(left))
    if gui_owner:
        close_owned_simulator_gui(gui_owner)
    boot = guest_boot_identity(device)
    if not boot or not any(x['udid'] == device and x['state'] == 'Booted' for x in devices()):
        return False
    token = os.urandom(8).hex()
    now = time.time()
    atomic_write(WARM, json.dumps(dict(device=device, boot=boot, profile=profile, disabledJobs=disabled_jobs, bootedAt=booted_at,
                                       lastUsed=now, until=now + seconds, token=token, reports=graphics_reports())).encode())
    start_warm_expiry(token)
    print('Simulator kept warm for %d min after this session (idle, window closed): %s' % (seconds // 60, device), flush=True)
    return True


def start_warm_expiry(token):
    # A detached timer, not a service: if it is lost, every guarded workload still ends an expired hold,
    # and a power loss ends the guest itself.
    env = {k: v for k, v in os.environ.items() if k not in ('IOS_REFRESH_LOCK_FD', 'IOS_WORKLOAD_ACTIVE')}
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'warm-expire', '--token', token], env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def warm_expire(token, poll=60):
    """Shut the held guest down at the end of its hour, or at once on a new GPU/panic report or memory
    pressure. Exits as soon as a session takes the guest over or holds it again (new token)."""
    strained = 0
    while True:
        state = warm_state()
        if not state or state.get('token') != token:
            return None
        reason = None
        if set(graphics_reports()) - set(state.get('reports', [])):
            reason = 'new Mac graphics failure report'
        strained = strained + 1 if memory_pressure() != 1 else 0
        if strained >= 2:
            reason = 'memory pressure'
        if time.time() >= state['until']:
            reason = 'idle for %d min' % round((state['until'] - state['lastUsed']) / 60)
        if reason:
            try:
                with signing_lock():
                    state = warm_state()
                    if not state or state.get('token') != token:
                        return None
                    held = held_warm(None)
                    if held:
                        release_warm(held, reason)
                    return reason
            except UnsafeWorkload:
                pass  # A workload holds the Mac; it ends an expired hold itself, or the next check does.
        time.sleep(max(1, min(poll, state['until'] - time.time())))


SPEECH_MODEL_CACHE = Path('/private/var/tmp/SpeechModelCache')
SPEECH_MODEL_BUDGET = 512 << 20
DERIVED_DATA = Path.home() / 'Library/Developer/Xcode/DerivedData'
DERIVED_DATA_IDLE = 3 * 86400


def prune_regenerable_caches(now=None):
    """Bound two regenerable caches that nothing else trims; returns bytes removed.

    Speech services compile their models into /private/var/tmp/SpeechModelCache (*.bnnsir) under a
    new name per asset/session; macOS never cleans /var/tmp, so it reached 3 GiB of ~400 MiB sets.
    The newest files within 512 MiB (the current set) stay so the next session need not recompile.
    Direct xcodebuild runs leave one DerivedData folder per checkout path; folders idle for three days
    are removed (ios-push builds in its own workspaces; Xcode's *.noindex caches self-prune)."""
    now = time.time() if now is None else now
    removed = 0
    try:
        files = sorted((f for f in SPEECH_MODEL_CACHE.glob('*.bnnsir') if f.is_file() and f.stat().st_uid == os.getuid()),
                       key=lambda f: f.stat().st_mtime, reverse=True)
    except OSError:
        files = []
    try:
        # Interrupted compilations leave NAME.bnnsir.<digits> temporaries that are never reused.
        stale = [f for f in SPEECH_MODEL_CACHE.glob('*.bnnsir.*') if f.is_file() and f.stat().st_uid == os.getuid()
                 and now - f.stat().st_mtime > 86400]
    except OSError:
        stale = []
    for f in stale:
        with contextlib.suppress(OSError):
            size = f.stat().st_size
            f.unlink()
            removed += size
    kept = 0
    for f in files:
        size = f.stat().st_size
        if kept + size <= SPEECH_MODEL_BUDGET:
            kept += size
            continue
        with contextlib.suppress(OSError):
            f.unlink()
            removed += size
    try:
        folders = [d for d in DERIVED_DATA.iterdir() if d.is_dir() and not d.name.endswith('.noindex')]
    except OSError:
        folders = []
    for d in folders:
        with contextlib.suppress(OSError):
            touched = max([d.stat().st_mtime] + [x.stat().st_mtime for x in (d / 'info.plist', d / 'Logs', d / 'Build') if x.exists()])
            if now - touched > DERIVED_DATA_IDLE:
                size = sum(x.stat().st_size for x in d.rglob('*') if x.is_file() and not x.is_symlink())
                shutil.rmtree(d)
                removed += size
    return removed


def assert_session(device):
    settings = policy()
    check_panic_reports(settings)
    lease = json.loads((ROOT / 'workload-current.json').read_text())
    os.kill(lease['pid'], 0)
    if lease.get('device') != device or lease['expiresAt'] < time.time():
        raise UnsafeWorkload('No active guarded session owns this simulator')
    simulator_policy(settings, lease.get('trial', False), metal_coalescing(),current_renderstandby=render_standby(settings))


def wasm_mode(args, settings):
    if getattr(args,'native_wasm',False):return 'default'
    if getattr(args,'wasm_compat',False):return 'compat'
    if getattr(args,'checked_wasm',False):return 'checked'
    configured=settings.get('simulatorWasmMode','default')
    if configured not in ('default','checked','compat'):
        raise UnsafeWorkload('Unknown recorded simulator Wasm mode')
    return configured if args.kind=='simulator' else 'default'


def run_workload(args):
    if not args.command:
        raise UnsafeWorkload('Provide the bounded command after --')
    if os.environ.get('IOS_WORKLOAD_ACTIVE'):
        raise UnsafeWorkload('Nested workloads are not allowed; build before booting the simulator')
    if args.kind == 'simulator':
        if queued_delivery(): raise UnsafeWorkload('Simulator deferred to queued app delivery')
        settings=policy()
        check_panic_reports(settings)
        simulator_policy(settings, args.trial, metal_coalescing(),current_renderstandby=render_standby(settings))
        if settings.get('simulatorRequiresGUI') and not getattr(args,'visible',False):
            raise UnsafeWorkload('This host requires --visible through the logged-in GUI session')
        if subprocess.run(['/usr/bin/pgrep','-x','Simulator'],stdout=subprocess.DEVNULL).returncode==0:
            raise UnsafeWorkload('Simulator.app is already open; this session cannot take over its GUI')
    mode = wasm_mode(args,policy())
    limits = trial_limits(policy(), args.trial, args.kind)
    with signing_lock() as fd:
        warm = held_warm(None)
        if warm and warm['until'] <= time.time():
            release_warm(warm, 'idle for %d min' % round((warm['until'] - warm['lastUsed']) / 60))
            warm = None
        known = wait_for_idle(getattr(args,'wait_for_idle',0),kind=args.kind,warm=warm)
        warm = held_warm(known)
        if args.kind=='simulator':check_panic_reports(policy())
        if args.kind=='simulator' and getattr(args,'visible',False) and subprocess.run(['/usr/bin/pgrep','-x','Simulator'],stdout=subprocess.DEVNULL).returncode==0:
            raise UnsafeWorkload('Simulator.app opened during admission wait; refusing to take over')
        if args.kind == 'simulator' and not any(x['udid'] == args.device and x.get('isAvailable') for x in known):
            raise UnsafeWorkload('The explicitly selected simulator is unavailable')
        duration = min(args.timeout, 600 if args.kind == 'simulator' else 900)
        if args.kind=='simulator' and args.trial and policy().get('trialUntil',0)<time.time()+duration+15:
            raise UnsafeWorkload('The recorded trial window is too short for this workload deadline')
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        report = ROOT / ('workload-' + stamp + '.jsonl')
        lease = ROOT / 'workload-current.json'
        disabled_jobs, profile_name = ([], None)
        if args.kind == 'simulator':
            runtime = next((x.get('runtime', '') for x in known if x['udid'] == args.device), '')
            app = getattr(args, 'app', None) or command_app(args.command)
            disabled_jobs, profile_name = simulator_profile(runtime, [n for n in (getattr(args, 'needs', '') or '').split(',') if n],
                                                            app, getattr(args, 'full', False))
            profile_name += ' (app %s)' % app if app else ''
            if warm:
                # Reuse needs the same guest and at least every service this check keeps running.
                mismatch = ('a cold boot was requested' if getattr(args, 'cold', False) else
                            'another device was requested' if warm['device'] != args.device else
                            'this check needs services the warm guest has off' if not set(warm['disabledJobs']) <= set(disabled_jobs) else None)
                if mismatch:
                    release_warm(warm, mismatch)
                    warm = None
                else:
                    disabled_jobs, profile_name = warm['disabledJobs'], warm['profile']
        lease.write_text(json.dumps(dict(pid=os.getpid(), device=args.device, trial=args.trial, profile=profile_name, disabledJobs=disabled_jobs,
                                         expiresAt=time.time() + duration, kind=args.kind,
                                         allowWebContentCrash=getattr(args,'allow_webcontent_crash',False),
                                         checkedWasm=mode in ('checked','compat'), wasmCompat=mode=='compat',wasmMode=mode)))
        # Retain at most the twenty newest small reports.
        for old in sorted(ROOT.glob('workload-*.jsonl'), reverse=True)[20:]:
            old.unlink()
        deadline = time.monotonic() + duration
        crash_watch = SimulatorFailureWatch(args.device,getattr(args,'allow_webcontent_crash',False)) if args.kind=='simulator' else None
        boot_attempted = False
        gui_started = False
        gui_owner = None
        command_finished = False
        crash_reason = None
        booted_at = time.time()
        try:
            with report.open('w') as log:
                print('Guarded %s; deadline %ss; limits %s; telemetry %s' % (args.kind, duration, limits, report), flush=True)
                if args.kind == 'simulator' and warm:
                    # Taken over from the hold: from here this session's cleanup owns the guest.
                    WARM.unlink(missing_ok=True)
                    boot_attempted = True
                    booted_at = warm['bootedAt']
                    boot_started = time.monotonic()
                    print('Simulator warm: reusing the guest booted %.0f min ago, idle %.0f min (%s, %d launchd jobs disabled)'
                          % ((time.time() - warm['bootedAt']) / 60, (time.time() - warm['lastUsed']) / 60, profile_name, len(disabled_jobs)), flush=True)
                elif args.kind == 'simulator':
                    # Before the boot is claimed: a guest someone else booted meanwhile is refused, never shut down.
                    if not any(x['udid'] == args.device and x['state'] == 'Shutdown' for x in devices()):
                        raise UnsafeWorkload('The selected simulator is not shut down; its launchd profile cannot be applied')
                    apply_simulator_profile(args.device, disabled_jobs)
                    print('Simulator profile: %s (%d launchd jobs disabled)' % (profile_name, len(disabled_jobs)), flush=True)
                    boot_attempted = True
                    boot = [tool_path('simctl'), 'boot', args.device]
                    if platform.machine() == 'x86_64':
                        boot.append('--arch=x86_64')
                    boot_started = time.monotonic()
                    booted_at = time.time()
                    monitor(boot, deadline, log, fd, 'boot', limits, crash_watch=crash_watch, yield_to_builds=True)
                if args.kind == 'simulator':
                    if getattr(args,'visible',False):
                        gui_started = True
                        # Only this owned GUI process leaves the guest running when it quits (the warm hold);
                        # the owner's own Simulator preference is untouched.
                        subprocess.run(['/usr/bin/open','-a','Simulator','--args','-CurrentDeviceUDID',args.device,
                                        '-DetachOnAppQuit','YES'],check=True,timeout=15)
                        gui_owner=simulator_gui_owner()
                        state=json.loads(lease.read_text());state['guiOwner']=gui_owner;lease.write_text(json.dumps(state))
                    monitor([tool_path('simctl'), 'bootstatus', args.device, '-b'], deadline, log, fd, 'bootstatus', limits, crash_watch=crash_watch, yield_to_builds=True)
                    print('Simulator ready after %.0f s (%s)' % (time.monotonic() - boot_started, profile_name), flush=True)
                try:
                    monitor(bounded_jobs(args.command) if args.kind == 'build' else args.command,
                            deadline, log, fd, 'command', limits,
                            intel_wasm_overrides() if mode=='compat' else (checked_wasm_overrides() if mode=='checked' else None),crash_watch=crash_watch,
                            yield_to_builds=args.kind=='simulator', warm=warm if args.kind=='build' else None)
                    command_finished = True
                except subprocess.CalledProcessError:
                    command_finished = True # A failing check still leaves a healthy guest to hold.
                    raise
        finally:
            cleaned = not boot_attempted
            try:
                crash_reason = crash_watch.failure() if crash_watch is not None else None
                seconds = warm_seconds() if boot_attempted and command_finished else 0
                if seconds and not crash_reason and \
                        not any(x['udid']!=args.device and x['state']!='Shutdown' for x in devices()):
                    try:
                        if hold_warm(args.device, gui_owner if gui_started else None, profile_name, disabled_jobs, booted_at, seconds):
                            boot_attempted = gui_started = False
                    except (UnsafeWorkload, subprocess.SubprocessError, OSError) as error:
                        print('Simulator not kept warm (%s); shutting it down' % error, flush=True)
                        WARM.unlink(missing_ok=True)
                if boot_attempted:
                    shutdown(args.device)
                if gui_started:
                    if any(x['udid']!=args.device and x['state']!='Shutdown' for x in devices()):
                        raise UnsafeWorkload('Another guest is active; leaving the shared GUI and recovery lease for coordination')
                    close_owned_simulator_gui(gui_owner)
                cleaned = True
            except Exception as error:
                recovery=json.loads(lease.read_text())
                recovery.update(cleanupFailed=str(error),expiresAt=0)
                lease.write_text(json.dumps(recovery))
                raise
            finally:
                if cleaned:
                    lease.unlink(missing_ok=True)
                with contextlib.suppress(Exception):
                    prune_regenerable_caches()
        if crash_watch is not None:
            reason=crash_reason or crash_watch.failure()
            if reason:raise UnsafeWorkload(reason)


def release_command():
    """End the warm hold now (e.g. before measuring an idle Mac)."""
    with signing_lock():
        warm = held_warm(None)
        if warm:
            release_warm(warm, 'requested')
        else:
            print('No simulator is held warm', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='kind', required=True)
    sub.add_parser('status')
    sub.add_parser('release-warm', help='Shut down the guest held warm after the last session')
    expiry = sub.add_parser('warm-expire', help=argparse.SUPPRESS)
    expiry.add_argument('--token', required=True)
    assertion = sub.add_parser('assert-simulator')
    assertion.add_argument('--device', required=True)
    for kind in ('build', 'simulator'):
        p = sub.add_parser(kind)
        p.add_argument('--timeout', type=int, default=300 if kind == 'simulator' else 900)
        p.add_argument('--wait-for-idle',type=int,default=180,help='Wait before starting, without changing admission limits (0-300 seconds)')
        p.add_argument('--device', required=kind == 'simulator')
        p.add_argument('--trial', action='store_true')
        if kind == 'simulator':
            p.add_argument('--visible', action='store_true', help='Owned GUI process, closed with the owned guest')
            p.add_argument('--allow-webcontent-crash',action='store_true',help='Explicit diagnostic comparison only: retain normal deadline/pressure checks')
            p.add_argument('--native-wasm',action='store_true',help='Explicit runtime-default JSC configuration for diagnostic controls')
            p.add_argument('--wasm-compat',action='store_true',help='Intel runtime compatibility: checked memory and baseline Wasm JIT instead of IPInt')
            p.add_argument('--checked-wasm',action='store_true',help='Simulator app launch flags: explicit Wasm bounds checks instead of the signal handler')
            p.add_argument('--needs', default='', help='Comma-separated service groups this check needs (simulator-profiles.json): media, photos, location, push, widgets, watch, siri, safari, store, icloud')
            p.add_argument('--app', help='Use the needs recorded for this ios-push project in simulator-profiles.json (default: the project named in the command path)')
            p.add_argument('--full', action='store_true', help='Boot every launchd job (no lean profile)')
            p.add_argument('--cold', action='store_true', help='Boot fresh even if the guest is held warm from the last session')
        p.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if platform.system() != 'Darwin':
        parser.error('Run this on the Mac; use ssh mac and the logged-in GUI bootstrap')
    if getattr(args, 'device', None) and not re.fullmatch(r'[A-Fa-f0-9-]{36}', args.device):
        parser.error('Use an explicit simulator UUID')
    os.umask(0o077)
    if args.kind == 'status':
        known = devices()
        warm = held_warm(known, drop=False)
        # The held idle guest is the guard's own, so it is reported apart and never blocks other work.
        print(json.dumps(dict(metrics=metrics(), booted=[x for x in known if x['state'] != 'Shutdown' and x['udid'] != (warm or {}).get('device')],
                              warm=warm and dict(device=warm['device'], profile=warm['profile'], bootedAt=warm['bootedAt'],
                                                 lastUsed=warm['lastUsed'], until=warm['until']),
                              policy=policy()), indent=2))
    elif args.kind == 'release-warm':
        release_command()
    elif args.kind == 'warm-expire':
        warm_expire(args.token)
    elif args.kind == 'assert-simulator':
        assert_session(args.device)
    else:
        if args.timeout <= 0:
            parser.error('Timeout must be positive')
        if args.command[:1] == ['--']:
            args.command = args.command[1:]
        run_workload(args)


if __name__ == '__main__':
    def interrupted(signum, frame):
        raise KeyboardInterrupt()
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    try:
        main()
    except (UnsafeWorkload, subprocess.SubprocessError, OSError, ValueError) as error:
        print('MAC WORKLOAD STOPPED: ' + str(error), file=sys.stderr, flush=True)
        sys.exit(1)
    except KeyboardInterrupt:
        print('MAC WORKLOAD CANCELLED; owned processes and guest cleaned up', file=sys.stderr, flush=True)
        sys.exit(130)
