#!/bin/bash
# Installs a signed app on the phone, wherever the phone is. Runs on the Mac.
#
#   phone-install [--ota] [--device <UDID>] <App.app>
#   phone-install --republish
#
# When the Mac reaches the phone (same network), it installs with devicectl over the same
# bundle ID, as before. Otherwise (the phone is away from the Mac), it publishes the app
# for an over-the-air install and prints the address: on the phone, from anywhere, open
# https://ios-apps.veron3.space, sign in and tap Install. --ota publishes without trying
# devicectl. Exit status: 0 installed, 10 published (installed once the phone's owner taps
# Install), anything else an error. --republish uploads what is already published again.
#
# The app must be signed with a profile that lists the phone (the team's development
# profile does). The phone is --device, or "device" in ios-tools.local.json. Published apps live
# in ~/Library/Application Support/phone-install and are uploaded to Hetzner
# (push/ota-site): the page needs the veron3 login; the manifest and the app, which iOS
# downloads itself without a login, sit under a random folder name that only the page knows.
set -euo pipefail

root="$HOME/Library/Application Support/phone-install"
site=https://ios-apps.veron3.space
upload=erdal@157.90.28.14

# The random folder name: made once, kept beside the published apps, never printed.
site_base() {
    mkdir -p "$root"
    [ -s "$root/.token" ] || (umask 077; /usr/bin/python3 -c 'import secrets; print(secrets.token_urlsafe(32), end="")' > "$root/.token")
    printf '%s/%s' "$site" "$(cat "$root/.token")"
}

# One page listing every published app, newest first, each with its install link; every
# manifest points at this site; then all of it is uploaded. The Mac's key for this can only
# run the receiving script on Hetzner.
publish() {
    local base info b n s when
    base=$(site_base)
    for info in "$root"/*/manifest.plist; do
        [ -f "$info" ] || continue
        /usr/bin/sed -i '' -E "s#<string>https://[^<]*/([^/<]+)/app\\.ipa\\?v=#<string>$base/\\1/app.ipa?v=#" "$info"
    done
    {
        echo '<!doctype html><meta name="viewport" content="width=device-width">'
        echo '<title>Install on the phone</title><body style="font:18px -apple-system;margin:24px">'
        for info in "$root"/*/info.tsv; do
            [ -f "$info" ] || continue
            b=$(basename "$(dirname "$info")")
            IFS=$'\t' read -r n s when < "$info"
            printf '%s\t<p><a href="itms-services://?action=download-manifest&amp;url=%s">Install %s</a><br><small>%s · %s</small></p>\n' \
                "$s" "$base/$b/manifest.plist%3Fv%3D$s" "$n" "$b" "$when"
        done | sort -rn | cut -f2-
    } > "$root/index.html"
    # The site as Hetzner serves it: the page on top, the apps under the random folder name.
    # It replaces the site there as a whole (push/ota-site/receive, the only thing this key runs).
    local stage
    stage=$(mktemp -d)
    mkdir "$stage/${base##*/}"
    for info in "$root"/*/info.tsv; do
        [ -f "$info" ] || continue
        /bin/cp -R "$(dirname "$info")" "$stage/${base##*/}/"
    done
    /bin/cp "$root/index.html" "$stage/index.html"
    COPYFILE_DISABLE=1 LC_ALL=C /usr/bin/tar -C "$stage" -cf - . |
        /usr/bin/ssh -i "$HOME/.ssh/ios-apps_ed25519" -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes \
            -o ConnectTimeout=15 "$upload" publish
    local status=$?
    rm -rf "$stage"
    return $status
}

if [ "${1:-}" = --republish ]; then
    publish || { echo "Could not upload to $site" >&2; exit 1; }
    echo "Uploaded the published apps to $site/"
    exit 0
fi

ota=no
device=
while [ $# -gt 1 ]; do
    case $1 in
        --ota) ota=yes; shift ;;
        --device) device=$2; shift 2 ;;
        *) break ;;
    esac
done
app=${1:?usage: phone-install [--ota] [--device <UDID>] <App.app>}
app=$(cd "$app" && pwd)
if [ -z "$device" ]; then
    config="$(cd "$(dirname "$0")/../.." && pwd)/ios-tools.local.json"
    device=$(/usr/bin/python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["device"])' "$config")
fi
plist() { /usr/libexec/PlistBuddy -c "Print :$1" "$app/Info.plist"; }
device_cli() { "$(dirname "$0")/apple-tool" devicectl "$@"; }
bundle=$(plist CFBundleIdentifier)
push_runner="$(cd "$(dirname "$0")/../.." && pwd)/push/worker.py"
if [ -f "$push_runner" ]; then
    /usr/bin/python3 "$push_runner" install-authority --bundle "$bundle"
fi

# Probe the app service that installation needs. Process enumeration can fail
# while app queries/installation work (for example while the DDI is unavailable).
# Catalog/details alone can still be cached; this contacts the requested phone.
reaches() { device_cli device info apps --device "$device" --timeout 15 --quiet >/dev/null 2>&1; }
if [ "$ota" = no ] &&
   { reaches || { "$(dirname "$0")/phone-pairing" --now && reaches; }; }; then
    install_log=$(mktemp)
    if device_cli device install app --device "$device" "$app" >"$install_log" 2>&1; then
        cat "$install_log"
        rm -f "$install_log"
        echo "Installed $bundle on the phone."
        exit 0
    else
        install_status=$?
        cat "$install_log" >&2
    fi
    # Catalog/details can succeed with a stale router/tunnel address while installation
    # fails. Repair once for connection failures; signing/package errors stay errors.
    if grep -Eiq 'unable to locate a device|device.*(unavailable|disconnected)|connection.*(invalid|lost|closed|failed)|CoreDeviceError error (1000|1001|1011|3002)' "$install_log"; then
        rm -f "$install_log"
        echo "Install lost the paired phone; repairing its wireless connection and retrying once."
        if "$(dirname "$0")/phone-pairing" --repair && reaches; then
            device_cli device install app --device "$device" "$app"
            echo "Installed $bundle on the phone after pairing recovery."
            exit 0
        fi
    else
        rm -f "$install_log"
        exit "$install_status"
    fi
    # Still no device path: use the normal over-the-air fallback below.
fi

# Over the air. The phone has to be in the app's provisioning profile.
profile=$(security cms -D -i "$app/embedded.mobileprovision" 2>/dev/null)
printf '%s' "$profile" | grep -q "<string>$device</string>" ||
    { echo "The app's provisioning profile does not list the phone ($device)." >&2; exit 1; }

base=$(site_base)
stamp=$(date +%s)
name=$(plist CFBundleDisplayName 2>/dev/null || plist CFBundleName)
version=$(plist CFBundleShortVersionString 2>/dev/null || echo 1.0)

# An .ipa is the app in a Payload folder, zipped.
mkdir -p "$root/$bundle"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir "$work/Payload"
ditto "$app" "$work/Payload/$(basename "$app")"
# An over-the-air install keeps the file modes in the .ipa. Builds made under umask 077 have
# owner-only files, which the app itself then cannot read (the system still launches it, so
# only bundled resources fail: the manga and gallery apps lost their PC address and key, and
# with it Load/Save and search). devicectl installs reset modes, which is why only OTA broke.
# Everyone may read; folders and executables stay traversable. Modes are not part of the
# code signature, which is checked again before the app is published.
chmod -R u+rwX,go+rX "$work/Payload"
codesign --verify --deep --strict "$work/Payload/$(basename "$app")" ||
    { echo "The app's signature does not verify; not publishing it." >&2; exit 1; }
(cd "$work" && ditto -c -k --norsrc --keepParent Payload app.ipa)
mv "$work/app.ipa" "$root/$bundle/app.ipa"

# ?v= keeps the phone from installing a cached copy of an earlier build.
cat > "$root/$bundle/manifest.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>items</key>
  <array>
    <dict>
      <key>assets</key>
      <array><dict>
        <key>kind</key><string>software-package</string>
        <key>url</key><string>$base/$bundle/app.ipa?v=$stamp</string>
      </dict></array>
      <key>metadata</key>
      <dict>
        <key>bundle-identifier</key><string>$bundle</string>
        <key>bundle-version</key><string>$version</string>
        <key>kind</key><string>software</string>
        <key>title</key><string>$name</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
EOF
printf '%s\t%s\t%s\n' "$name" "$stamp" "$(date '+%Y-%m-%d %H:%M')" > "$root/$bundle/info.tsv"

publish || { echo "Could not upload $name to $site" >&2; exit 1; }

echo "The Mac cannot reach the phone; published $name ($bundle) for an over-the-air install."
echo "On the phone, open $site/, sign in and tap \"Install $name\"."
exit 10
