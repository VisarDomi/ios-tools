#!/usr/bin/env python3
"""Query or update one Watch app through its already trusted paired iPhone.

Run with inspector/.venv/bin/python under the caller's shared signing lock.
This uses ordinary lockdown, never another attachment to Apple's shared RSD.
"""
import argparse
import asyncio
import json
import os
from pathlib import Path
import plistlib
import signal
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from watch_companion import paired_watch
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'renewal/scripts'))
from refresh import save


def validate_app(path, watch, bundle, team):
    info = plistlib.loads((path / 'Info.plist').read_bytes())
    if info.get('CFBundleSupportedPlatforms') != ['WatchOS'] or info.get('CFBundleIdentifier') != bundle:
        raise RuntimeError('The signed bundle is not the intended WatchOS app.')
    profile = plistlib.loads(subprocess.check_output(
        ['/usr/bin/security', 'cms', '-D', '-i', str(path / 'embedded.mobileprovision')], stderr=subprocess.PIPE, timeout=15))
    if (watch not in profile.get('ProvisionedDevices', []) or team not in profile.get('TeamIdentifier', [])
            or profile.get('Entitlements', {}).get('application-identifier') != team + '.' + bundle):
        raise RuntimeError('The Watch profile does not match the device, team and bundle.')
    subprocess.run(['/usr/bin/codesign', '--verify', '--deep', '--strict', str(path)], check=True, timeout=20)
    return str(info['CFBundleVersion'])


async def operate(args):
    from pymobiledevice3.services.installation_proxy import InstallationProxyService
    expected = validate_app(args.install, args.watch, args.bundle, args.team) if args.install else None
    progress = lambda stage: print('Watch companion stage: ' + stage, flush=True)
    async with paired_watch(args.phone, args.watch, wifi_only=args.phone_wifi, progress=progress) as watch:
        async with InstallationProxyService(watch) as service:
            if args.install:
                progress('installing-signed-app')
                await asyncio.wait_for(service.install_from_local(args.install, developer=True), 100)
            progress('reading-installed-app')
            apps = await asyncio.wait_for(service.get_apps(bundle_identifiers=[args.bundle]), 20)
        rows = [{'bundleIdentifier': bundle, 'bundleVersion': str(info.get('CFBundleVersion', '')),
                 'version': info.get('CFBundleShortVersionString')} for bundle, info in apps.items()]
        if expected is not None and not any(row['bundleIdentifier'] == args.bundle and row['bundleVersion'] == expected for row in rows):
            raise RuntimeError('Watch installation was not confirmed by actual app inventory.')
        return {'device': args.watch, 'transport': 'companion-lockdown', 'installed': bool(args.install), 'apps': rows}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--phone', required=True)
    parser.add_argument('--watch', required=True)
    parser.add_argument('--bundle', required=True)
    parser.add_argument('--json-output', required=True, type=Path)
    parser.add_argument('--install', type=Path)
    parser.add_argument('--team')
    parser.add_argument('--phone-wifi', action='store_true')
    args = parser.parse_args()
    if sys.platform != 'darwin' or os.geteuid() == 0:
        parser.error('Run in the logged-in Mac user session with the existing inspector Python.')
    if args.install and not args.team:
        parser.error('--install requires --team')
    for key in tuple(os.environ):
        if key.startswith('SUDO_'): os.environ.pop(key, None)
    os.umask(0o077)
    args.json_output.unlink(missing_ok=True)

    async def run():
        loop = asyncio.get_running_loop()
        current = asyncio.current_task()
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            loop.add_signal_handler(sig, current.cancel)
        return await asyncio.wait_for(operate(args), 150 if args.install else 45)

    try:
        result = asyncio.run(run())
    except (Exception, asyncio.CancelledError) as error:
        raise SystemExit('Watch companion request: ' + type(error).__name__) from None
    save(args.json_output, result)
    print('Paired Watch app inventory verified' + (' after in-place installation.' if args.install else '.'))


if __name__ == '__main__':
    main()
