#!/usr/bin/env python3
"""Run installed simctl/devicectl directly, or print their versions with status."""
import json
import os
import sys
from apple_tools import status,tool_path

if sys.argv[1:]==['status']:
    print(json.dumps(status(),indent=2))
elif len(sys.argv)>1 and sys.argv[1] in ('simctl','devicectl'):
    try:
        path=tool_path(sys.argv[1])
        os.execv(path,[path,*sys.argv[2:]])
    except (OSError,RuntimeError,ValueError) as error:
        raise SystemExit(str(error))
else:
    raise SystemExit('usage: apple-tool status | simctl ... | devicectl ...')
