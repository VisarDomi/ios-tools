#!/usr/bin/python3
"""Keeps the Mac's wireless link to the phone working. Runs on the Mac.

Sometimes devicectl keeps stale connection details after a Wi-Fi change. Bonjour
multicast can also fail while the phone is reachable directly. Restore discovery
using the existing trusted identity before restarting Mac pairing services:

  phone-pairing            one check; the LaunchAgent com.visar.phone-pairing runs it every
                           30 s; repair after two failed real device requests while on the
                           LAN, or when a recently connected phone loses its old address.
                           Address changes bypass prior backoff. Retries back off
                           10 minutes (an hour after failure with a reachable address).
                           Known phones with broken discovery keep retrying every 10 minutes.
                           Host interface/route changes reset the backoff even if
                           the old phone hostname no longer resolves. A fresh
                           cache also starts authenticated discovery automatically.
  phone-pairing --now      check, and restart right away even if Bonjour is stale
  phone-pairing --repair   repair after an installer reports a stale CoreDevice connection
  phone-pairing --install  write and load the LaunchAgent
  phone-pairing --probe    test a real device request without repairing anything

An unreachable endpoint does not establish that the phone is away or using a VPN.
Automatic recovery leaves Apple services untouched unless unicast discovery first
authenticates the configured phone. It never changes phone networking or trust.
Events go to ~/Library/Logs/phone-pairing.log.
"""
import fcntl
import datetime
import json
import re
import os
import plistlib
import subprocess
import sys
import tempfile
import time
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parent))
from apple_tools import tool_path

LABEL = 'com.visar.phone-pairing'
ROOT = Path(__file__).resolve().parents[2]
STATE = Path.home() / 'Library/Application Support/phone-pairing/state.json'
LOG = Path.home() / 'Library/Logs/phone-pairing.log'
CHECKS = 2               # unavailable checks in a row before restarting
WAIT = 600               # seconds between restarts
RECENT = 1800            # rediscover a phone lost within the last 30 minutes, even without old-IP replies
WAIT_FAILED = 3600       # ... after a restart that did not bring the phone back
WORKLOAD_LOCK = Path.home()/'Library/Caches/ios-app-refresh/signing.lock'


def say(text):
    print(time.strftime('%Y-%m-%d %H:%M:%S ') + text, flush=True)


def phone():
    """Probe a real request; CoreDevice's catalog can say connected after its tunnel dies."""
    udid = json.loads((ROOT / 'ios-tools.local.json').read_text())['device']
    hosts = []
    recent = False
    try:
        with tempfile.TemporaryDirectory() as work:
            out = Path(work) / 'devices.json'
            result = subprocess.run([tool_path('devicectl'), 'list', 'devices', '--quiet',
                                     '--timeout', '12', '--json-output', str(out)],
                                    capture_output=True, text=True, timeout=15)
            devices = json.loads(out.read_text())['result']['devices'] if out.exists() else []
        device = next((d for d in devices if d.get('hardwareProperties', {}).get('udid') == udid), None)
        if device:
            props = device.get('connectionProperties', {})
            stamp = props.get('lastConnectionDate')
            if stamp:
                try:
                    connected = datetime.datetime.fromisoformat(stamp.replace('Z','+00:00')).timestamp()
                    recent = 0 <= time.time()-connected <= RECENT
                except (ValueError,TypeError):
                    pass
            for name in props.get('potentialHostnames', []) + props.get('localHostnames', []):
                host = name.replace('.coredevice.local', '.local')
                # Ignore generated UDID/UUID aliases; they are not the phone's LAN Bonjour name.
                label = host.split('.')[0].replace('-', '')
                if host.endswith('.local') and not re.fullmatch(r'[0-9a-fA-F]{24,40}', label):
                    if host not in hosts:
                        hosts.append(host)
        # This contacts the device rather than relying on the cached catalog/details.
        result = subprocess.run([tool_path('devicectl'), 'device', 'info', 'processes',
                                 '--device', udid, '--timeout', '15', '--quiet'],
                                capture_output=True, text=True, timeout=18)
        reason = (result.stderr or result.stdout).strip()[-500:]
        # A locked phone / missing developer image is a response from the phone,
        # not evidence of a broken wireless pairing path.
        responded = bool(re.search(r'device (?:is|must be) (?:un)?locked|developer disk image is not mounted',
                                   reason, re.IGNORECASE))
        return result.returncode == 0 or responded, hosts, reason, recent
    except (subprocess.TimeoutExpired, OSError, ValueError, KeyError) as error:
        return False, hosts, str(error), recent


def reachable(hosts):
    """Try current Bonjour IPv4 and IPv6; an old A record need not block recovery."""
    try:
        route = subprocess.run(['/sbin/route', '-n', 'get', 'default'],
                               capture_output=True, text=True, timeout=4).stdout
        interface = re.search(r'interface:\s*(\S+)', route)
        identity = '|'.join(line.strip() for line in route.splitlines()
                            if line.strip().startswith(('gateway:', 'interface:')))
    except (subprocess.TimeoutExpired, OSError):
        interface, identity = None, ''
    for host in hosts:
        probes = [['/sbin/ping', '-c', '1', '-t', '2', host]]
        if interface:
            probes.append(['/sbin/ping6', '-c', '1', '-t', '2', '-I', interface.group(1), host])
        for args in probes:
            try:
                result = subprocess.run(args,capture_output=True,text=True,timeout=4)
                if result.returncode == 0:
                    address = re.search(r'\(([^)]+)\)', result.stdout) if args[0].endswith('/ping') else None
                    target = address.group(1) if address else result.stdout.splitlines()[0].split('-->')[-1].strip()
                    return host + '|' + target + '|' + identity
            except (subprocess.TimeoutExpired, OSError, IndexError):
                continue
    return None


def host_network():
    """Detect host topology without relying on the missing phone's Bonjour name."""
    try:
        route = subprocess.run(['/sbin/route', '-n', 'get', 'default'],
                               capture_output=True, text=True, timeout=4)
        links = subprocess.run(['/sbin/ifconfig', '-a'],
                               capture_output=True, text=True, timeout=4)
        if links.returncode != 0:
            return None
        active = []
        for block in re.split(r'(?=^\S[^\n]*: flags=)', links.stdout, flags=re.M):
            match = re.match(r'((?:en|bridge)\d+): flags=', block)
            if match and 'status: active' in block:
                addresses = re.findall(r'\binet (\S+) netmask (\S+)', block)
                active.extend('%s|%s|%s' % (match[1], ip, mask) for ip, mask in addresses)
        return dict(interfaces=sorted(active), route='|'.join(
            line.strip() for line in route.stdout.splitlines()
            if line.strip().startswith(('gateway:', 'interface:'))))
    except (subprocess.TimeoutExpired, OSError):
        return None


def discovery_generation():
    """A fresh authenticated endpoint registration can outlive old repair backoff."""
    try:
        udid = json.loads((ROOT / 'ios-tools.local.json').read_text())['device']
        if not isinstance(udid, str):
            return None
        identity = udid.replace('-', '').lower()
        if not re.fullmatch(r'(?:[0-9a-f]{24}|[0-9a-f]{40})', identity):
            return None
        endpoint = json.loads((STATE.parent / ('discovery-' + identity + '.json')).read_text())
        if not isinstance(endpoint, dict):
            return None
        if (not endpoint.get('registered') or not endpoint.get('registeredAt') or
                not 0 <= time.time() - endpoint.get('verified', 0) < 60):
            return None
        return [endpoint['registeredAt'], endpoint['address'], endpoint['interface'], endpoint['port']]
    except (OSError, ValueError, KeyError, TypeError):
        return None


def restart(discovery=False, allow_services=True):
    # A reachable phone can be invisible to Bonjour after roaming between APs.
    # Validate its existing identity over unicast, publish its actual current RSD
    # endpoint, and only restart Apple services if a real request still fails.
    authenticated = bootstrap_discovery()
    if authenticated:
        for attempt in range(3):
            if phone()[0]: return True
            if attempt < 2: time.sleep(2)
    elif not allow_services:
        say('No authenticated phone endpoint on the active LAN; leaving Apple services untouched.')
        return False
    # Keep trust records. A dead cached address needs discovery/transport refresh,
    # not just the two pairing processes used for a stale but reachable tunnel.
    services = ['user/%s/com.apple.CoreDevice.remotepairingd' % os.getuid(),
                'user/%s/com.apple.CoreDevice.CoreDeviceService' % os.getuid()]
    if discovery:
        services += ['system/com.apple.remoted','system/com.apple.usbmuxd']
        subprocess.run(['/usr/bin/dscacheutil','-flushcache'],check=False)
        # Address the launchd job, including this Mac's reloaded Apple job,
        # instead of signalling every process with a matching name.
        for label in ['com.apple.mDNSResponder','com.apple.mDNSResponder.reloaded']:
            target = 'system/' + label
            present = subprocess.run(['/usr/bin/sudo','-n','/bin/launchctl','print',target],
                                     stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            if present.returncode == 0:
                subprocess.run(['/usr/bin/sudo','-n','/bin/launchctl','kill','SIGHUP',target],check=False)
                break
    for target in services:
        result = subprocess.run(['/usr/bin/sudo','-n','/bin/launchctl','kickstart','-k',target],
                                capture_output=True,text=True,check=False)
        if result.returncode:
            say('Could not refresh launchd job %s (exit %s).' % (target,result.returncode))
    for _ in range(6):
        time.sleep(5)
        if phone()[0]:
            return True
    return False


def bootstrap_discovery():
    python = ROOT / 'inspector/.venv/bin/python'
    helper = ROOT / 'native/scripts/phone-discovery'
    if not python.is_file() or not helper.is_file(): return False
    try:
        result = subprocess.run([str(python), str(helper), '--ensure', '--wait', '30'],
                                capture_output=True, text=True, timeout=60)
        if result.returncode == 0:
            endpoint = json.loads(result.stdout)
            say('Authenticated unicast discovery: %s on %s; native Bonjour endpoint refreshed.' %
                (endpoint.get('address'), endpoint.get('interface')))
            return True
    except (OSError, ValueError, subprocess.TimeoutExpired): pass
    return False


def check(now, force=False):
    try:
        state = json.loads(STATE.read_text()) if STATE.exists() else {}
    except (ValueError, OSError):
        state = {}
    visible, hosts, reason, recent = phone()
    hosts = hosts or state.get('hosts', [])
    network = reachable(hosts)
    topology = host_network()
    host_changed = bool(topology is not None and 'hostNetwork' in state and
                        topology != state['hostNetwork'])
    registration = discovery_generation()
    rediscovered = bool(registration is not None and registration != state.get('discoveryGeneration'))
    changed = host_changed or rediscovered or bool(network and network != state.get('network') and
                                                 (state.get('network') or state.get('failed') or state.get('status') == 'unreachable'))
    if topology is not None:
        state['hostNetwork'] = topology
    if registration is not None:
        state['discoveryGeneration'] = registration
    recent = recent or time.time()-state.get('seen',0) <= RECENT
    if hosts:
        state['hosts'] = hosts
    if network:
        state['network'] = network
    # Pairing configuration is sufficient to try authenticated discovery. A new
    # or discarded cache must not require a past successful Bonjour connection.
    wait = WAIT_FAILED if network and state.get('failed') else WAIT
    due = time.time() - state.get('fixed', 0) >= wait
    rediscover = due
    if visible and not force:
        if state.get('misses') or state.get('status') == 'unreachable':
            say('The phone is available again (device request succeeded).')
        state['misses'] = 0
        state['failed'] = False
        state['status'] = 'healthy'
        state['seen'] = time.time()
    elif not network and not recent and not now and not rediscover and not changed:
        if state.get('status') != 'unreachable':
            say('The phone request failed and Bonjour IPv4/IPv6 do not answer; awaiting the phone on the LAN.')
        state['status'] = 'unreachable'
        state['misses'] = 0
    else:
        state['misses'] = state.get('misses', 0) + 1
        if now or changed or (state['misses'] >= CHECKS and due):
            say('%s%s; restoring discovery, then refreshing %s if needed. %s' %
                ('The phone is on the LAN but its device request failed' if network else
                 'The paired phone disappeared and its old Bonjour address does not answer',
                 ' after a network change' if changed else '',
                 'Bonjour discovery and device transports' if (changed or force or not network or state.get('failed')) else 'pairing',
                 reason or 'Installer requested repair.'))
            state['fixed'] = time.time()
            discovery = changed or force or not network or state.get('failed', False)
            # Scheduled checks may rediscover an absent/roaming phone, but must
            # not restart global services without an authenticated endpoint.
            visible = restart(discovery=discovery, allow_services=now)
            if not visible and not discovery:
                say('Pairing-only repair did not restore the device; refreshing Bonjour and device transports.')
                visible = restart(discovery=True, allow_services=now)
            state['failed'] = not visible
            if visible:
                say('The phone is available again (device request succeeded).')
                state['misses'] = 0
                state['seen'] = time.time()
                state['status'] = 'healthy'
            else:
                say('Still unavailable; automatic checks will continue with backoff.')
    if not visible:
        state['status'] = 'unreachable'
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE.with_suffix('.tmp')
    temporary.write_text(json.dumps(state))
    temporary.replace(STATE)
    return 0 if visible else 1


def state_locked_check(now, force=False):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    # The LaunchAgent and an installer may run together. One service restart at a time.
    with STATE.with_suffix('.lock').open('a') as lock:
        deadline = time.monotonic() + (90 if now else 0)
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return check(now, force)
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    return 1 if now else 0
                time.sleep(1)


def locked_check(now, force=False):
    # Automatic device upkeep must yield to builds/UI tests and cold host startup.
    if not now and os.getloadavg()[0]>6:
        return 0
    WORKLOAD_LOCK.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    with WORKLOAD_LOCK.open('a') as workload:
        deadline=time.monotonic()+(90 if now else 0)
        while True:
            try:
                fcntl.flock(workload,fcntl.LOCK_EX|fcntl.LOCK_NB)
                return state_locked_check(now,force)
            except BlockingIOError:
                if time.monotonic()>=deadline:
                    if now:say('Mac workload active; device maintenance deferred.')
                    return 1 if now else 0
                time.sleep(1)


def install():
    target = Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')
    domain = 'gui/' + str(os.getuid())
    LOG.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(plistlib.dumps(dict(
        Label=LABEL, RunAtLoad=True, StartInterval=30, LimitLoadToSessionType='Aqua',
        ProgramArguments=['/usr/bin/python3', str(Path(__file__).resolve())],
        StandardOutPath=str(LOG), StandardErrorPath=str(LOG))))
    target.chmod(0o600)
    subprocess.run(['/bin/launchctl', 'bootout', domain + '/' + LABEL], stderr=subprocess.DEVNULL)
    subprocess.run(['/bin/launchctl', 'enable', domain + '/' + LABEL], check=True)
    subprocess.run(['/bin/launchctl', 'bootstrap', domain, str(target)], check=True)
    print('Loaded %s: checks the phone every 30 s; events in %s.' % (LABEL, LOG))


if __name__ == '__main__':
    if sys.argv[1:] == ['--install']:
        install()
    elif sys.argv[1:] in ([], ['--now'], ['--repair']):
        sys.exit(locked_check(bool(sys.argv[1:]), sys.argv[1:] == ['--repair']))
    elif sys.argv[1:] == ['--probe']:
        sys.exit(0 if phone()[0] else 1)
    else:
        sys.exit(__doc__)
