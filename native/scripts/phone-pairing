#!/usr/bin/python3
"""Keeps the Mac's wireless link to the phone working. Runs on the Mac.

Sometimes devicectl keeps stale connection details after a Wi-Fi change, even while
its catalog says connected and the phone answers on the LAN. The Mac's pairing services
are stuck then, and restarting them brings the phone back. This does that by itself:

  phone-pairing            one check; the LaunchAgent com.visar.phone-pairing runs it every
                           30 s; repair after two failed real device requests while on the
                           LAN, or when a recently connected phone loses its old address.
                           Address changes bypass prior backoff. Retries back off
                           10 minutes (an hour after failure); a network change resets this.
  phone-pairing --now      check, and restart the services right away if they are stuck
  phone-pairing --repair   repair after an installer reports a stale CoreDevice connection
  phone-pairing --install  write and load the LaunchAgent

Restarting does not help while the phone's Tailscale is on: it hides the phone's pairing
path from the Mac. Events go to ~/Library/Logs/phone-pairing.log.
"""
import fcntl
import datetime
import json
import re
import os
import plistlib
import subprocess
import sys
import tempfile
import time
from pathlib import Path

LABEL = 'com.visar.phone-pairing'
ROOT = Path(__file__).resolve().parents[2]
STATE = Path.home() / 'Library/Application Support/phone-pairing/state.json'
LOG = Path.home() / 'Library/Logs/phone-pairing.log'
CHECKS = 2               # unavailable checks in a row before restarting
WAIT = 600               # seconds between restarts
RECENT = 1800            # rediscover a phone lost within the last 30 minutes, even without old-IP replies
WAIT_FAILED = 3600       # ... after a restart that did not bring the phone back


def say(text):
    print(time.strftime('%Y-%m-%d %H:%M:%S ') + text, flush=True)


def phone():
    """Probe a real request; CoreDevice's catalog can say connected after its tunnel dies."""
    udid = json.loads((ROOT / 'ios-tools.local.json').read_text())['device']
    hosts = []
    recent = False
    try:
        with tempfile.TemporaryDirectory() as work:
            out = Path(work) / 'devices.json'
            result = subprocess.run(['/usr/bin/xcrun', 'devicectl', 'list', 'devices', '--quiet',
                                     '--timeout', '12', '--json-output', str(out)],
                                    capture_output=True, text=True, timeout=15)
            devices = json.loads(out.read_text())['result']['devices'] if out.exists() else []
        device = next((d for d in devices if d.get('hardwareProperties', {}).get('udid') == udid), None)
        if device:
            props = device.get('connectionProperties', {})
            stamp = props.get('lastConnectionDate')
            if stamp:
                try:
                    connected = datetime.datetime.fromisoformat(stamp.replace('Z','+00:00')).timestamp()
                    recent = 0 <= time.time()-connected <= RECENT
                except (ValueError,TypeError):
                    pass
            for name in props.get('potentialHostnames', []) + props.get('localHostnames', []):
                host = name.replace('.coredevice.local', '.local')
                # Ignore generated UDID/UUID aliases; they are not the phone's LAN Bonjour name.
                label = host.split('.')[0].replace('-', '')
                if host.endswith('.local') and not re.fullmatch(r'[0-9a-fA-F]{24,40}', label):
                    if host not in hosts:
                        hosts.append(host)
        # This contacts the device rather than relying on the cached catalog/details.
        result = subprocess.run(['/usr/bin/xcrun', 'devicectl', 'device', 'info', 'processes',
                                 '--device', udid, '--timeout', '15', '--quiet'],
                                capture_output=True, text=True, timeout=18)
        reason = (result.stderr or result.stdout).strip()[-500:]
        # A locked phone / missing developer image is a response from the phone,
        # not evidence of a broken wireless pairing path.
        responded = bool(re.search(r'device (?:is|must be) (?:un)?locked|developer disk image is not mounted',
                                   reason, re.IGNORECASE))
        return result.returncode == 0 or responded, hosts, reason, recent
    except (subprocess.TimeoutExpired, OSError, ValueError, KeyError) as error:
        return False, hosts, str(error), recent


def reachable(hosts):
    """Try current Bonjour IPv4 and IPv6; an old A record need not block recovery."""
    try:
        route = subprocess.run(['/sbin/route', '-n', 'get', 'default'],
                               capture_output=True, text=True, timeout=4).stdout
        interface = re.search(r'interface:\s*(\S+)', route)
        identity = '|'.join(line.strip() for line in route.splitlines()
                            if line.strip().startswith(('gateway:', 'interface:')))
    except (subprocess.TimeoutExpired, OSError):
        interface, identity = None, ''
    for host in hosts:
        probes = [['/sbin/ping', '-c', '1', '-t', '2', host]]
        if interface:
            probes.append(['/sbin/ping6', '-c', '1', '-t', '2', '-I', interface.group(1), host])
        for args in probes:
            try:
                result = subprocess.run(args,capture_output=True,text=True,timeout=4)
                if result.returncode == 0:
                    address = re.search(r'\(([^)]+)\)', result.stdout) if args[0].endswith('/ping') else None
                    target = address.group(1) if address else result.stdout.splitlines()[0].split('-->')[-1].strip()
                    return host + '|' + target + '|' + identity
            except (subprocess.TimeoutExpired, OSError, IndexError):
                continue
    return None


def restart(discovery=False):
    # Keep trust records. A dead cached address needs discovery/transport refresh,
    # not just the two pairing processes used for a stale but reachable tunnel.
    services = ['remotepairingd','CoreDeviceService']
    if discovery:
        services += ['remoted','usbmuxd']
        subprocess.run(['/usr/bin/dscacheutil','-flushcache'],check=False)
        subprocess.run(['/usr/bin/sudo','-n','/usr/bin/killall','-HUP','mDNSResponder'],check=False)
    for name in services:
        pids = subprocess.run(['/usr/bin/pgrep','-x',name],capture_output=True,text=True).stdout.split()
        if pids:
            subprocess.run(['/usr/bin/sudo','-n','/bin/kill','-9']+pids,check=False)
    for _ in range(6):
        time.sleep(5)
        if phone()[0]:
            return True
    return False


def check(now, force=False):
    try:
        state = json.loads(STATE.read_text()) if STATE.exists() else {}
    except (ValueError, OSError):
        state = {}
    visible, hosts, reason, recent = phone()
    hosts = hosts or state.get('hosts', [])
    network = reachable(hosts)
    changed = bool(network and network != state.get('network') and
                   (state.get('network') or state.get('failed') or state.get('status') == 'unreachable'))
    recent = recent or time.time()-state.get('seen',0) <= RECENT
    if hosts:
        state['hosts'] = hosts
    if network:
        state['network'] = network
    if visible and not force:
        if state.get('misses') or state.get('status') == 'unreachable':
            say('The phone is available again (device request succeeded).')
        state['misses'] = 0
        state['failed'] = False
        state['status'] = 'healthy'
        state['seen'] = time.time()
    elif not network and not recent:
        if state.get('status') != 'unreachable':
            say('The phone request failed and Bonjour IPv4/IPv6 do not answer; awaiting the phone on the LAN.')
        state['status'] = 'unreachable'
        state['misses'] = 0   # no reachable LAN phone: do not restart unrelated services
    else:
        state['misses'] = state.get('misses', 0) + 1
        wait = WAIT_FAILED if state.get('failed') else WAIT
        due = time.time() - state.get('fixed', 0) >= wait
        if now or changed or (state['misses'] >= CHECKS and due):
            say('%s%s; restarting %s. %s' %
                ('The phone is on the LAN but its device request failed' if network else
                 'A recently connected phone disappeared and its old Bonjour address does not answer',
                 ' after a network change' if changed else '',
                 'Bonjour discovery and device transports' if (changed or force or not network or state.get('failed')) else 'pairing',
                 reason or 'Installer requested repair.'))
            state['fixed'] = time.time()
            discovery = changed or force or not network or state.get('failed', False)
            visible = restart(discovery=discovery)
            if not visible and not discovery:
                say('Pairing-only repair did not restore the device; refreshing Bonjour and device transports.')
                visible = restart(discovery=True)
            state['failed'] = not visible
            if visible:
                say('The phone is available again (device request succeeded).')
                state['misses'] = 0
                state['seen'] = time.time()
                state['status'] = 'healthy'
            else:
                say('Still unavailable; automatic checks will continue with backoff.')
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE.with_suffix('.tmp')
    temporary.write_text(json.dumps(state))
    temporary.replace(STATE)
    return 0 if visible else 1


def locked_check(now, force=False):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    # The LaunchAgent and an installer may run together. One service restart at a time.
    with STATE.with_suffix('.lock').open('a') as lock:
        deadline = time.monotonic() + (90 if now else 0)
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return check(now, force)
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    return 1 if now else 0
                time.sleep(1)


def install():
    target = Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')
    domain = 'gui/' + str(os.getuid())
    LOG.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(plistlib.dumps(dict(
        Label=LABEL, RunAtLoad=True, StartInterval=30, LimitLoadToSessionType='Aqua',
        ProgramArguments=['/usr/bin/python3', str(Path(__file__).resolve())],
        StandardOutPath=str(LOG), StandardErrorPath=str(LOG))))
    target.chmod(0o600)
    subprocess.run(['/bin/launchctl', 'bootout', domain + '/' + LABEL], stderr=subprocess.DEVNULL)
    subprocess.run(['/bin/launchctl', 'enable', domain + '/' + LABEL], check=True)
    subprocess.run(['/bin/launchctl', 'bootstrap', domain, str(target)], check=True)
    print('Loaded %s: checks the phone every 30 s; events in %s.' % (LABEL, LOG))


if __name__ == '__main__':
    if sys.argv[1:] == ['--install']:
        install()
    elif sys.argv[1:] in ([], ['--now'], ['--repair']):
        sys.exit(locked_check(bool(sys.argv[1:]), sys.argv[1:] == ['--repair']))
    else:
        sys.exit(__doc__)
