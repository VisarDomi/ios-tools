{
  "custom-twitter": {
    "path": "custom-twitter",
    "declaration": "scripts/renewal.py"
  },
  "t3-watch": {
    "path": "ai/t3-watch",
    "declaration": "tools/renewal.py",
    "aliases": {
      "t3watch": "t3-watch"
    }
  },
  "video-platform": {
    "path": "video/video-platform",
    "prepare": "video",
    "aliases": {
      "filehost": "filehost-local",
      "fmp4": "fmp4-local",
      "ladder": "ladder-local",
      "tslive": "tslive-live",
      "tslive-local": "tslive-local",
      "vault": "vault"
    },
    "persistentBuildCache": {
      "apps": [
        "filehost-local"
      ],
      "maximumBytes": 2147483648,
      "cacheRoots": [
        "build/filehost/native",
        "build/filehost/DerivedData"
      ],
      "shared": {
        "apps": [
          "tslive-local",
          "ladder-local",
          "fmp4-local",
          "vault",
          "tslive-live"
        ],
        "maximumBytes": 2147483648,
        "cacheRoots": [
          "build/app/DerivedData",
          "build/app/native"
        ]
      }
    },
    "tests": [
      "bash",
      "apps/ios/scripts/test.sh"
    ]
  },
  "manga-reader": {
    "path": "manga/manga-reader",
    "persistentBuildCache": true,
    "tests": [
      "bash",
      "apps/ios/scripts/test.sh"
    ]
  },
  "gallery-reader": {
    "path": "manga/gallery-reader",
    "prepare": "gallery",
    "persistentBuildCache": {
      "shared": {
        "apps": [
          "gallery-a",
          "gallery-b"
        ],
        "maximumBytes": 2147483648,
        "cacheRoots": [
          "build/shared/DerivedData",
          "build/shared/native"
        ]
      }
    },
    "tests": [
      "bash",
      "apps/ios/scripts/test.sh"
    ]
  },
  "gallery-downloader": {
    "path": "manga/gallery-downloader",
    "persistentBuildCache": {
      "apps": [
        "gallery"
      ],
      "cacheRoots": [
        "apps/ios/build/DerivedData"
      ],
      "maximumBytes": 2147483648
    },
    "tests": [
      "bash",
      "apps/ios/scripts/test.sh"
    ]
  },
  "trader": {
    "path": "trading/trader"
  },
  "guidance": {
    "path": "games/guidance"
  },
  "deep-town": {
    "path": "games/deep-town",
    "carry": [
      "build/robovm/DeepTown.app"
    ]
  }
}
